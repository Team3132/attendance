{
	"$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
	"productName": "attendance",
	"identifier": "com.team3132.attendance",
	"build": {
		"frontendDist": "../dist/client",
		"devUrl": "http://localhost:1420",
		"beforeDevCommand": "bun dev",
		"beforeBuildCommand": "bun run build"
	},
	"app": {
		"windows": [
			{
				"title": "attendance",
				"width": 800,
				"height": 600,
				"resizable": true,
				"fullscreen": false
			}
		],
		"security": {
			"csp": null
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		]
	},
	"plugins": {
		"deep-link": {
			"desktop": {
				"schemes": ["attendance"]
			},
			"mobile": [
				{
					"scheme": ["attendance"],
					"appLink": false
				}
			]
		}
	}
}
